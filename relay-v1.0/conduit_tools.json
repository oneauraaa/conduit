[
  {
    "name": "screenshot",
    "group": "vision",
    "risky": false,
    "description": "Capture the screen as a PNG. Prefer read_screen_text when you only need text or control positions; use this for layout, images, or visual confirmation.",
    "parameters": {
      "type": "object",
      "properties": {
        "display": {
          "type": "integer",
          "description": "Display index; defaults to the primary display.",
          "minimum": 0
        },
        "region": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Optional [x, y, width, height] crop in display coordinates."
        },
        "scale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.0,
          "description": "Optional capture scale from 0.1 to 1.0."
        }
      },
      "required": []
    }
  },
